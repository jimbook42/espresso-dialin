{
  "name": "espresso-dialin",
  "private": true,
  "version": "4.10.3",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:flair-lab": "vite --mode flairlab --host",
    "build": "vite build",
    "build:scale": "VITE_SCALE_ALLOW_SIM=true vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "preview:scale": "VITE_SCALE_ALLOW_SIM=true vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test": "node test.js && node src/utils/recommendationTuning.test.js && node src/grinders/grinderRegistry.test.js && node src/grinders/engineSnapshots.test.js && node scripts/check-dist-manifest.mjs",
    "test:vitest": "vitest run",
    "test:playwright-heldback": "node scripts/playwright-heldback-grinders-smoke.mjs",
    "test:playwright-bean-finish-undo": "node scripts/playwright-bean-finish-undo-smoke.mjs",
    "test:playwright-bean-reactivate": "node scripts/playwright-bean-reactivate-smoke.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "dexie": "^4.4.6",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.44.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.5.6",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "playwright": "^1.64.0",
    "postcss": "^8.5.28",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.7"
  }
}
